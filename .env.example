# ========================
# Database (PostgreSQL)
# ========================
DB_NAME=hiring_platform
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432
# NOTE: When using Docker Compose, DB_HOST is automatically
# overridden to 'db' (the Docker service name). No changes needed.

# ========================
# Django
# ========================
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=True

# ========================
# AI Service API Keys
# ========================
NVIDIA_LLM_API_KEY=your_key_for_llama_70b_here
NVIDIA_EMBED_API_KEY=your_key_for_nv_embed_here
NVIDIA_CHAT_API_KEY=your_key_for_llama_8b_here
AI_SERVICE_URL=http://localhost:8001
# NOTE: When using Docker Compose, AI_SERVICE_URL is automatically
# overridden to 'http://ai_service:8001'. No changes needed.

# ========================
# Internal Service Auth
# ========================
INTERNAL_API_TOKEN=your_internal_token_here
